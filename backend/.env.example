# Copy this file to .env and edit.

SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-too

# Database (SQLite by default; use e.g. postgresql://user:pass@host/db later)
DATABASE_URL=sqlite:///ems.db

# First admin account, created automatically on first start
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@rohini.com
ADMIN_PASSWORD=Admin@123

# Frontend URL allowed to call the API (CORS)
FRONTEND_ORIGIN=http://localhost:5173
# Link used inside emails
APP_URL=http://localhost:5173

# ---- Email (SMTP) ----
# Leave MAIL_SERVER empty to run without sending real mail:
# emails are then only printed in the console and saved in the Email Log page.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=khairerahul885@gmail.com
# For Gmail use an "App Password", not your normal password
MAIL_PASSWORD=atuw wirm moas jetl
MAIL_FROM_NAME=Rohini People Technology
MAIL_FROM=

# ---- Reminders ----
# How often the server checks for overdue tasks (minutes)
REMINDER_CHECK_MINUTES=15
# After the first overdue mail, repeat every N hours until the task is done (0 = send only once)
OVERDUE_REPEAT_HOURS=24
# Also email the person who assigned the task when it is overdue
CC_ASSIGNER_ON_OVERDUE=true
# Email the assignee as soon as a task is assigned to them
NOTIFY_ON_ASSIGN=true
